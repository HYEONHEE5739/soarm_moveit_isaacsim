QWidget {
    background-color: #1e1e1e;
    color: #f0f0f0;
    font-size: 14px;
}

QGroupBox {
    border: 1px solid #444;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px 0 4px;
}

QSlider::groove:horizontal {
    height: 8px;
    background: #444;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: #4da3ff;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}

QPushButton {
    background-color: #2d89ef;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
}

QPushButton:hover {
    background-color: #4da3ff;
}

QLabel {
    font-size: 13px;
}